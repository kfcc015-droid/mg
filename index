    <!-- JavaScript Logic -->
    <script>
        // Global Chart Instances
        let waterfallChart = null;
        let pieChart = null;
        let impactChart = null;

        // Navigation Tab Switcher
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));

            document.getElementById('sec-' + tabId).classList.remove('hidden');
            document.getElementById('tab-' + tabId).classList.add('active');

            // Re-render charts when switching to relevant tabs to prevent canvas size rendering bugs
            if (tabId === 'simulator') {
                setTimeout(updateSimulation, 50);
            } else if (tabId === 'risk') {
                setTimeout(renderRiskChart, 50);
            } else if (tabId === 'roadmap') {
                setTimeout(renderImpactChart, 50);
            }
        }

        // Section 2: Interest Rate Simulator Logic
        function updateSimulation() {
            const amount = parseInt(document.getElementById('sim-amount-slider').value);
            document.getElementById('sim-amount-text').innerText = amount.toLocaleString() + ' 만원';

            const baseRate = parseFloat(document.getElementById('sim-base-rate').value);
            
            let discounts = 0;
            if (document.getElementById('chk-market').checked) discounts += 0.5;
            if (document.getElementById('chk-localpay').checked) discounts += 0.5;
            if (document.getElementById('chk-mobile').checked) discounts += 0.3;
            if (document.getElementById('chk-capital').checked) discounts += 0.2;
            if (document.getElementById('chk-gov').checked) discounts += 0.5;

            // Cap maximum discount at 2.0%p
            const finalDiscount = Math.min(discounts, 2.0);
            const finalRate = Math.max(baseRate - finalDiscount, 2.5);

            document.getElementById('res-final-rate').innerText = finalRate.toFixed(2) + '%';
            document.getElementById('res-discount-total').innerText = `(총 우대금리 -${finalDiscount.toFixed(1)}%p 적용)`;

            // Calculation for Monthly Payment
            const periodMonths = parseInt(document.getElementById('sim-period').value);
            const type = document.getElementById('sim-type').value;
            const principal = amount * 10000;
            const monthlyRate = (finalRate / 100) / 12;

            let monthlyPayment = 0;
            if (type === 'equal') {
                monthlyPayment = (principal * monthlyRate * Math.pow(1 + monthlyRate, periodMonths)) / (Math.pow(1 + monthlyRate, periodMonths) - 1);
            } else {
                monthlyPayment = principal * monthlyRate; // Interest only
            }

            document.getElementById('res-monthly-pay').innerText = Math.round(monthlyPayment).toLocaleString() + ' 원';

            // Calculate total saved interest vs base rate
            const baseMonthlyRate = (baseRate / 100) / 12;
            let baseMonthlyPay = (principal * baseMonthlyRate * Math.pow(1 + baseMonthlyRate, periodMonths)) / (Math.pow(1 + baseMonthlyRate, periodMonths) - 1);
            const totalSavings = Math.round((baseMonthlyPay - monthlyPayment) * periodMonths);
            document.getElementById('res-total-saved').innerText = `약 ${(totalSavings / 10000).toFixed(0)}만 원 절감`;

            // Update Chart
            renderWaterfallChart(baseRate, finalDiscount, finalRate);
        }

        function renderWaterfallChart(base, discount, final) {
            const ctx = document.getElementById('rateWaterfallChart').getContext('2d');
            
            if (waterfallChart) {
                waterfallChart.destroy();
            }

            waterfallChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['기본 금리', '우대 감면폭', '최종 적용 금리'],
                    datasets: [{
                        label: '금리 (%)',
                        data: [base, discount, final],
                        backgroundColor: ['#1E56A0', '#10B981', '#0F2C59'],
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.raw.toFixed(2) + '%';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 8,
                            ticks: {
                                callback: function(value) { return value + '%'; }
                            }
                        }
                    }
                }
            });
        }

        // Section 3: Eligibility Quiz Logic
        function checkEligibility() {
            const q1 = document.querySelector('input[name="q1"]:checked').value;
            const q2 = document.querySelector('input[name="q2"]:checked').value;
            const q3 = document.querySelector('input[name="q3"]:checked').value;

            const box = document.getElementById('eligibility-result-box');
            const dot = document.getElementById('status-dot');
            const title = document.getElementById('eligibility-status');
            const desc = document.getElementById('eligibility-desc');

            if (q1 === 'yes' && q2 === 'yes' && q3 === 'yes') {
                dot.className = 'w-3 h-3 bg-emerald-500 rounded-full';
                title.innerText = '원스톱 대출 신청 가능 대상입니다';
                title.className = 'text-xl font-extrabold text-emerald-800 mb-2';
                desc.innerText = "고객님은 'MG 상생 희망드림 대출' 우대 조건 및 지원 자격을 완벽히 충족합니다. MG더뱅킹 앱을 통해 무방문으로 10분 이내 승인을 진행하실 수 있습니다.";
            } else if (q3 === 'no') {
                dot.className = 'w-3 h-3 bg-red-500 rounded-full';
                title.innerText = '신청 불가 (체납/연체 이력 존재)';
                title.className = 'text-xl font-extrabold text-red-700 mb-2';
                desc.innerText = "국세/지방세 체납 또는 금융기관 연체 이력이 존재하는 경우 신규 대출 신청이 제한됩니다. 세금 납부 후 재진단을 권장합니다.";
            } else {
                dot.className = 'w-3 h-3 bg-amber-500 rounded-full';
                title.innerText = '지점 방문 유선 상담 권장';
                title.className = 'text-xl font-extrabold text-amber-800 mb-2';
                desc.innerText = "영업 기간 3개월 미만이거나 전통시장/지역화폐 가맹 증빙이 불명확할 경우, 가까운 새마을금고 지점에 방문하시면 추가 서류 검토 후 심사가 가능합니다.";
            }
        }

        // Section 4: Risk Guarantee Chart & EWS Simulation
        function renderRiskChart() {
            const ctx = document.getElementById('guaranteePieChart').getContext('2d');
            if (pieChart) pieChart.destroy();

            pieChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['신용보증재단 보증 담보 (90%)', '금고 자체 위험 노출 (10%)'],
                    datasets: [{
                        data: [90, 10],
                        backgroundColor: ['#0F2C59', '#E53E3E'],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        }

        function simulateEws() {
            const val = document.getElementById('ews-select').value;
            const alertBox = document.getElementById('ews-alert-box');

            if (val === 'normal') {
                alertBox.className = 'p-3 bg-emerald-50 border border-emerald-200 rounded text-xs font-medium text-emerald-800';
                alertBox.innerHTML = '<strong>[상태: 정상]</strong> 매출 변동이 안정적입니다. 정상 상환 모니터링을 유지합니다.';
            } else if (val === 'warning') {
                alertBox.className = 'p-3 bg-amber-50 border border-amber-200 rounded text-xs font-medium text-amber-800';
                alertBox.innerHTML = '<strong>[주의 경보 발령]</strong> 카드 매출 30% 감소 감지. 1:1 상생 컨설팅 안내 문자 자동 발송 및 만기 연장 옵션 사전 안내.';
            } else {
                alertBox.className = 'p-3 bg-red-50 border border-red-200 rounded text-xs font-medium text-red-800';
                alertBox.innerHTML = '<strong>[위기 경보 발령]</strong> 매출 50% 급감. 사전 워크아웃(원금 상환 유예 최대 12개월) 모듈 자동 활성화 및 담당자 현장 방문.';
            }
        }

        // Section 5: Impact Bar Chart
        function renderImpactChart() {
            const ctx = document.getElementById('impactBarChart').getContext('2d');
            if (impactChart) impactChart.destroy();

            impactChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['신규 차주 유입(명)', '지역화폐 계좌(건)', 'MG더뱅킹 신규(건)'],
                    datasets: [{
                        label: '목표치 (시범 사업 기준)',
                        data: [1500, 2200, 3100],
                        backgroundColor: ['#10B981', '#1E56A0', '#0F2C59'],
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });
        }

        // Initial Load Event
        window.addEventListener('DOMContentLoaded', () => {
            updateSimulation();
        });
    </script>
